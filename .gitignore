node_modules/
dist/
source/node_modules/
source/dist/
source/.netlify/
# The native build output and everything Xcode/Gradle regenerates. The ios/ and
# android/ project folders themselves are committed -- they hold real config
# (entitlements, icons, Info.plist) that `npx cap add` will not put back.
source/dist-app/
# The motion lab's build output. Experimental, not deployed, nobody's webDir.
# It also carries ~69MB of MediaPipe wasm copied out of node_modules.
source/motion-lab/dist-lab/
source/ios/App/Pods/
source/ios/App/App/public/
# Generated by scripts/sync-app-version.mjs before every native build. Holds
# the marketing version and the build number; committing it would just be
# churn, and a stale value can never ship because the build regenerates it.
source/ios/App/App/Version.xcconfig
source/android/app/src/main/assets/public/
source/android/.gradle/
source/android/build/
source/android/app/build/
source/android/local.properties
# Generated by scripts/sync-app-version.mjs, like Version.xcconfig above.
source/android/app/version.properties
# The staff app's copies of the same generated files and build output.
source/booking-app/ios/App/App/Version.xcconfig
source/booking-app/android/app/version.properties
source/booking-app/ios/App/Pods/
source/booking-app/ios/App/App/public/
source/booking-app/android/app/src/main/assets/public/
source/booking-app/android/.gradle/
source/booking-app/android/build/
source/booking-app/android/app/build/
source/booking-app/android/local.properties
# The Tap to Pay plugin's Gradle output when the staff app is built.
source/native/clarity-terminal/android/build/
# Signing keys never belong in the repo. CI rebuilds one from a secret.
*.jks
*.keystore
# The upload-key passwords (copied from keystore.properties.example).
source/android/keystore.properties
source/booking-app/android/keystore.properties
# Where `npm run native:release:aab` files the bundles. Big binaries, and the
# stores hold the copy that matters; only the README is tracked.
releases/*
!releases/README.md

.netlify/
.DS_Store

.env
.env.*
!.env.example

# Local dev database. Held the admin password hash, salt and seed key in a
# public repo. Never commit it.
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
source/server/clarity-booking.sqlite

# Staging area for files on their way out. Nothing in here is part of the
# build, and git on some setups can't unlink its own index.lock, so stale
# lock artefacts collect here too. Never commit it.
_to_delete/
integration-decoupling.tgz
apply-integration-decoupling.sh
_transfer.tgz
frontend-decoupling.tgz
ui-rearrange.tgz
ui-tokens.tgz
ui-rule08.tgz
ui-rule06.tgz
ui-settings.tgz
ui-accordions.tgz
ui-layout-fix.tgz
integrations-list.tgz
integrations-status-fix.tgz
google-scope-fix.tgz

# The npm lockfile, deliberately untracked.
source/package-lock.json
source/node_modules
# The staff app's own install (booking-app/ has its own package.json).
source/booking-app/node_modules/
