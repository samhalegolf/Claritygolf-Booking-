+    if (error?.status !== 409) throw error;
+    return googleCalendarRequest(
+      accessToken,
+      `/calendars/${encodedCalendarId}/events/${encodeURIComponent(eventId)}?sendUpdates=none`,
+      { method: "PUT", body: JSON.stringify(event) },
