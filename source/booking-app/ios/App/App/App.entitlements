<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tap to Pay on iPhone. Needs Apple's approval for this bundle id before it
	     will sign: see docs/stripe-terminal-ios-setup.md. -->
	<key>com.apple.developer.proximity-reader.payment.acceptance</key>
	<true/>
	<!-- Push notifications (booking alerts). Xcode signs a release build with
	     "production"; see docs/staff-app-push-setup.md. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
