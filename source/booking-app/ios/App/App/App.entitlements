<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tap to Pay on iPhone (com.apple.developer.proximity-reader.payment.acceptance)
	     is off until Apple grants the distribution entitlement; see
	     capacitor.config.ts (ios.includePlugins) to bring it back. -->
	<!-- Push notifications (booking alerts). Xcode signs a release build with
	     "production"; see docs/staff-app-push-setup.md. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
