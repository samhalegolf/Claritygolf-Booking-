# Copy to keystore.properties in this folder and fill in. That copy is gitignored,
# and so is the .jks: neither the keystore nor its passwords belong in the repo.
#
# This is the Play UPLOAD key. Let Play App Signing hold the real signing key,
# so a lost upload key can be reset in Play Console rather than ending the app.
# Still, back the .jks up somewhere durable and separate from this machine.
#
# Make the keystore once (keytool asks for the passwords, so they never land in
# shell history):
#
#   keytool -genkeypair -v \
#     -keystore booking-app/android/clarity-booking-upload.jks \
#     -alias clarity-booking-upload \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to android/app, so a keystore at
# booking-app/android/clarity-booking-upload.jks is ../clarity-booking-upload.jks here.

storeFile=../clarity-booking-upload.jks
storePassword=
keyAlias=clarity-booking-upload
keyPassword=

# CI alternative: leave this file absent and set ANDROID_KEYSTORE_PATH,
# ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS and ANDROID_KEY_PASSWORD instead.
